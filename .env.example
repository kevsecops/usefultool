# =============================================================================
# Docker Compose: copy this file to .env, then choose a mode:
#
#   Development (hot reload):  make dev
#   Development (watch mode):  make dev-watch
#   Production / demo deploy:  docker compose up -d --build   (or: make up)
#
# Compose overrides DATABASE_URL, DEMO_MODE, and API URLs for in-network services.
# =============================================================================

# Application
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database — use localhost when running backend on the host; Compose sets postgres hostname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/usefultool

# Demo mode — Compose sets DEMO_MODE=false for live ingest by default.
# Use DEMO_MODE=true for offline fixture-based demos.
DEMO_MODE=false

# Showcase mode — curated demo scenarios without external API keys.
# When true, loads fixtures/showcase/ on startup and labels data as Showcase/Demo.
SHOWCASE_MODE=false

LOG_FORMAT=json
FIXTURES_DIR=fixtures

# Admin authentication
ADMIN_TOKEN=change-me-in-production

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
# Browser (client components, map): host-published API port
NEXT_PUBLIC_API_URL=http://localhost:8000
# Next.js server-side fetches inside Docker network
API_URL=http://backend:8000

# NOAA — User-Agent is required by api.weather.gov
NOAA_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
NOAA_BASE_URL=https://api.weather.gov
NOAA_FETCH_TIMEOUT_SECONDS=30
NOAA_MAX_RETRIES=3
NOAA_USE_FIXTURES=false
NOAA_FALLBACK_TO_FIXTURES=true

# Comma-separated sources to fetch live when DEMO_MODE=false.
# Default MVP trio: nina,gdacs,noaa
# Full showcase stack (fixture fallback when API keys missing):
#   nina,gdacs,noaa,usgs,eonet,noaa_swpc,firms
SOURCES_LIVE=nina,gdacs,noaa

# NINA — MoWaS + DWD for MVP
NINA_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
NINA_BASE_URL=https://warnung.bund.de/api31
NINA_FETCH_TIMEOUT_SECONDS=10
NINA_MAX_RETRIES=3
NINA_USE_FIXTURES=false
NINA_FALLBACK_TO_FIXTURES=false

# GDACS
GDACS_BASE_URL=https://www.gdacs.org
GDACS_FETCH_TIMEOUT_SECONDS=15
GDACS_MAX_RETRIES=3
GDACS_USE_FIXTURES=false
GDACS_FALLBACK_TO_FIXTURES=true

# USGS Earthquakes — official GeoJSON feeds (add usgs to SOURCES_LIVE for live ingest)
USGS_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
USGS_BASE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0
USGS_FETCH_TIMEOUT_SECONDS=30
USGS_MAX_RETRIES=3
USGS_USE_FIXTURES=false
USGS_FALLBACK_TO_FIXTURES=true

# NASA EONET — natural events (add eonet to SOURCES_LIVE for live ingest)
EONET_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
EONET_FETCH_TIMEOUT_SECONDS=30
EONET_MAX_RETRIES=3
EONET_USE_FIXTURES=false
EONET_FALLBACK_TO_FIXTURES=true

# NOAA Space Weather (SWPC) — separate from NWS; add noaa_swpc to SOURCES_LIVE
NOAA_SWPC_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
NOAA_SWPC_BASE_URL=https://services.swpc.noaa.gov/products
NOAA_SWPC_FETCH_TIMEOUT_SECONDS=30
NOAA_SWPC_MAX_RETRIES=3
NOAA_SWPC_USE_FIXTURES=false
NOAA_SWPC_FALLBACK_TO_FIXTURES=true

# NASA FIRMS — active fire clusters (requires free MAP_KEY for live; fixtures in DEMO_MODE)
# Register at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
FIRMS_MAP_KEY=
FIRMS_PRODUCT=VIIRS_SNPP_NRT
FIRMS_AREA_COORDS=0,36,20,46
FIRMS_DAY_RANGE=1
FIRMS_REGION_LABEL=Southern Europe / Mediterranean
FIRMS_FETCH_TIMEOUT_SECONDS=30
FIRMS_MAX_RETRIES=3
FIRMS_USE_FIXTURES=false
FIRMS_FALLBACK_TO_FIXTURES=true
FIRMS_CLUSTER_GRID_DEG=0.5
FIRMS_CLUSTER_TIME_HOURS=24
FIRMS_MIN_CLUSTER_POINTS=3

# Event correlation (Phase 4)
CORRELATION_TIME_WINDOW_HOURS=24
CORRELATION_DISTANCE_KM=150
CORRELATION_AUTO_RUN=true

# Exposure analysis (Phase 5)
EXPOSURE_BUFFER_KM=50
EXPOSURE_AUTO_IMPORT=true
EXPOSURE_AUTO_RUN=false

# Implications engine (Phase 6)
IMPLICATIONS_AUTO_RUN=false

# LLM — disabled by default; enable explicitly for LLM briefings
LLM_ENABLED=false
LLM_PROVIDER=mock
# OpenAI: https://api.openai.com/v1
# Ollama (from Docker): http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_MAX_EVENTS=20
LLM_MAX_EXPOSURES_PER_EVENT=10

# Risk scoring (Phase 5)
RISK_SCORE_SCALING=50

# Background ingest scheduler — enabled by default in docker-compose.yml
STARTUP_PIPELINE_ENABLED=true
AUTO_GENERATE_BRIEFING=true
SCHEDULER_ENABLED=false
INGEST_INTERVAL_MINUTES=15
SCHEDULER_GENERATE_BRIEFING=true
SCHEDULER_STARTUP_DELAY_SECONDS=30

# Per-source scheduler intervals (minutes). Overrides INGEST_INTERVAL_MINUTES for each source.
# JSON map takes precedence unless overridden by individual env vars below.
# SOURCE_SCHEDULES={"noaa":10,"usgs":5,"gdacs":10,"nina":15,"eonet":30,"noaa_swpc":15,"firms":60}
# NINA_INTERVAL_MINUTES=15
# GDACS_INTERVAL_MINUTES=10
# NOAA_INTERVAL_MINUTES=10
# USGS_INTERVAL_MINUTES=5
# EONET_INTERVAL_MINUTES=30
# NOAA_SWPC_INTERVAL_MINUTES=15
# FIRMS_INTERVAL_MINUTES=60

# Data retention — delete inactive records older than N days (startup + daily cleanup)
OBSERVED_EVENTS_RETENTION_DAYS=90
ALERTS_RETENTION_DAYS=30
RETENTION_CLEANUP_ENABLED=true
