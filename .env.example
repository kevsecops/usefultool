# Application
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/usefultool

# Demo mode — use fixtures instead of live APIs
DEMO_MODE=false
FIXTURES_DIR=fixtures

# Admin authentication
ADMIN_TOKEN=change-me-in-production

# CORS
FRONTEND_URL=http://localhost:3000

# NOAA — User-Agent is required by api.weather.gov
NOAA_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
NOAA_BASE_URL=https://api.weather.gov
NOAA_FETCH_TIMEOUT_SECONDS=30
NOAA_MAX_RETRIES=3
NOAA_USE_FIXTURES=false
NOAA_FALLBACK_TO_FIXTURES=true

# Comma-separated sources to fetch live when DEMO_MODE=false (Phase 3: noaa only)
SOURCES_LIVE=noaa

# NINA — MoWaS + DWD only for MVP
NINA_BASE_URL=https://warnung.bund.de/api31

# GDACS
GDACS_BASE_URL=https://www.gdacs.org

# LLM — core analysis layer (mock in demo, OpenAI-compatible in prod)
LLM_ENABLED=true
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048

# Risk scoring (Phase 5)
RISK_SCORE_SCALING=50
