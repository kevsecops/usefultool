# =============================================================================
# Docker Compose (recommended): copy this file and run `docker compose up -d`
# Compose overrides DATABASE_URL, DEMO_MODE, and API URLs for in-network services.
# =============================================================================

# Application
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database — use localhost when running backend on the host; Compose sets postgres hostname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/usefultool

# Demo mode — Compose sets DEMO_MODE=false for live ingest by default.
# Use DEMO_MODE=true for offline fixture-based demos.
DEMO_MODE=false
LOG_FORMAT=json
FIXTURES_DIR=fixtures

# Admin authentication
ADMIN_TOKEN=change-me-in-production

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
# Browser (client components, map): host-published API port
NEXT_PUBLIC_API_URL=http://localhost:8000
# Next.js server-side fetches inside Docker network
API_URL=http://backend:8000

# NOAA — User-Agent is required by api.weather.gov
NOAA_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
NOAA_BASE_URL=https://api.weather.gov
NOAA_FETCH_TIMEOUT_SECONDS=30
NOAA_MAX_RETRIES=3
NOAA_USE_FIXTURES=false
NOAA_FALLBACK_TO_FIXTURES=true

# Comma-separated sources to fetch live when DEMO_MODE=false (Phase 7: all three)
SOURCES_LIVE=nina,gdacs,noaa

# NINA — MoWaS + DWD for MVP
NINA_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
NINA_BASE_URL=https://warnung.bund.de/api31
NINA_FETCH_TIMEOUT_SECONDS=10
NINA_MAX_RETRIES=3
NINA_USE_FIXTURES=false
NINA_FALLBACK_TO_FIXTURES=false

# GDACS
GDACS_BASE_URL=https://www.gdacs.org
GDACS_FETCH_TIMEOUT_SECONDS=15
GDACS_MAX_RETRIES=3
GDACS_USE_FIXTURES=false
GDACS_FALLBACK_TO_FIXTURES=true

# USGS Earthquakes — official GeoJSON feeds (add usgs to SOURCES_LIVE for live ingest)
USGS_USER_AGENT=GlobalRiskIntelligence/1.0 (contact@example.com)
USGS_BASE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0
USGS_FETCH_TIMEOUT_SECONDS=30
USGS_MAX_RETRIES=3
USGS_USE_FIXTURES=false
USGS_FALLBACK_TO_FIXTURES=true

# LLM — disabled by default; enable explicitly for LLM briefings
LLM_ENABLED=false
LLM_PROVIDER=mock
# OpenAI: https://api.openai.com/v1
# Ollama (from Docker): http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048

# Risk scoring (Phase 5)
RISK_SCORE_SCALING=50

# Background ingest scheduler — enabled by default in docker-compose.yml
AUTO_GENERATE_BRIEFING=true
SCHEDULER_ENABLED=false
INGEST_INTERVAL_MINUTES=15
SCHEDULER_GENERATE_BRIEFING=true
SCHEDULER_STARTUP_DELAY_SECONDS=30
